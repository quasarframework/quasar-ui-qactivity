{
  "meta": {
    "docsUrl": "https://qactivity.netlify.app/developing/using-qactivity"
  },

  "props": {
    "dense": {
      "type": "Boolean",
      "category": "behavior",
      "desc": "Dense mode; occupies less space"
    },
    "bar-color": {
      "type": "String",
      "category": "style",
      "desc": "CSS color (no Quasar colors allowed here)",
      "examples": ["blue", "#0000FF"]
    },
    "bar-width": {
      "type": "String",
      "category": "style",
      "desc": "Size in CSS units, including unit name",
      "examples": ["2px"]
    },
    "bar-distance": {
      "type": "String",
      "category": "style",
      "desc": "Distance from the inline start edge to the center of the timeline bar",
      "examples": ["16px", "1rem"]
    },
    "bar-start": {
      "type": "String",
      "category": "style",
      "desc": "Controls the beginning of the timeline bar",
      "values": ["default", "hidden", "arrow", "round", "rounded"],
      "examples": ["hidden", "arrow", "round", "rounded"]
    },
    "bar-end": {
      "type": "String",
      "category": "style",
      "desc": "Controls the end of the timeline bar",
      "values": ["default", "hidden", "arrow", "round", "rounded"],
      "examples": ["hidden", "arrow", "round", "rounded"]
    },
    "bar-cap-size": {
      "type": "String",
      "category": "style",
      "desc": "Size in CSS units for hidden bar offsets and arrow caps",
      "examples": ["8px", "0.5rem"]
    }
  },
  "slots": {
    "default": {
      "desc": "Anything can go into this slot, but a QActivityItem component is expected"
    }
  }
}
